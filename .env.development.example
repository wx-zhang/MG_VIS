# Customer source bundle: fill your own credentials when enabling integrations.
NODE_ENV=development
TYR_NODE_INTERPRETER=
HOST=127.0.0.1
PORT=3001
TYR_SERVER_URL=http://127.0.0.1:3001
TYR_DATA_DIR=./tyr-data
TYR_WEB_ROOT=./apps/web/dist
# P1 RuntimeSession isolation. Keep off by default; set codex for local acceptance.
TYR_RUNTIME_CONTEXT_SESSIONS=off
# Optional comma-separated Agent ids. Empty means all Codex Agents when enabled.
TYR_RUNTIME_CONTEXT_SESSION_AGENT_IDS=
VITE_BASE_PATH=/
VITE_TYR_API_BASE=
VITE_TYR_REALTIME_PATH=

## Helpdesk email signup mock flow.
TYR_HELPDESK_EMAIL=help@example.com
TYR_SIGNUP_MODE=invite_only
TYR_SIGNUP_ALLOWLIST=
TYR_HELPDESK_MOCK_INBOUND=0
TYR_HELPDESK_MOCK_SECRET=
TYR_HELPDESK_RATE_LIMIT_MOCK_IP_LIMIT=10
TYR_HELPDESK_RATE_LIMIT_MOCK_IP_WINDOW_SECONDS=600
TYR_HELPDESK_RATE_LIMIT_MOCK_EMAIL_LIMIT=5
TYR_HELPDESK_RATE_LIMIT_MOCK_EMAIL_WINDOW_SECONDS=3600
TYR_HELPDESK_RATE_LIMIT_META_IP_LIMIT=60
TYR_HELPDESK_RATE_LIMIT_META_IP_WINDOW_SECONDS=600
TYR_HELPDESK_RATE_LIMIT_COMPLETE_IP_LIMIT=20
TYR_HELPDESK_RATE_LIMIT_COMPLETE_IP_WINDOW_SECONDS=600
TYR_HELPDESK_RATE_LIMIT_COMPLETE_TOKEN_LIMIT=5
TYR_HELPDESK_RATE_LIMIT_COMPLETE_TOKEN_WINDOW_SECONDS=600
TYR_HELPDESK_RESEND_INBOUND=0
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
TYR_HELPDESK_RESEND_FROM="TYR Demo <help@example.com>"
TYR_RESEND_API_BASE_URL=https://api.resend.com

## Telegram connector. First version supports logged-in account binding only.
TYR_TELEGRAM_ENABLED=0
TYR_TELEGRAM_BOT_TOKEN=
TYR_TELEGRAM_BOT_USERNAME=
TYR_TELEGRAM_WEBHOOK_SECRET=
TYR_TELEGRAM_API_BASE_URL=https://api.telegram.org

## Passive safety audit writes Safety review records for new approvals and completed turns.
## Enable model or dry-run safety audit only when this explicit switch is 1.
TYR_SAFETY_AUDIT_ENABLED=0
TYR_SAFETY_AUDIT_MODE=model
TYR_SAFETY_AUDIT_MODEL=qwen3.7-plus

## Shared Qwen-compatible model endpoint used by safety audit and governance.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

## TYR LLM decision layer. When enabled, it reuses QWEN_API_KEY/QWEN_BASE_URL unless overridden.
TYR_ASSISTANT_LLM_ENABLED=0
TYR_ASSISTANT_LLM_MODEL=qwen3.7-plus
# TYR_ASSISTANT_LLM_API_KEY=
# TYR_ASSISTANT_LLM_BASE_URL=

## Pre-action trajectory governance runs before runtime approval decisions.
TYR_GOVERNANCE_ENABLED=0
TYR_GOVERNANCE_MODE=assist
TYR_GOVERNANCE_MODEL=qwen3.7-plus
TYR_GOVERNANCE_MAX_EVENTS=30
TYR_GOVERNANCE_MAX_CASE_CHARS=24000
# Optional server-side policy override. Keep empty to use built-in defaults.
# Example:
# TYR_GOVERNANCE_POLICY_JSON={"default":{"cross_context":"require_human","secret_external_send":"deny"}}
TYR_BOOTSTRAP_SEED=default
